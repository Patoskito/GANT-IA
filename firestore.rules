rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /initiatives/{initiativeId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /areas/{areaId} {
      allow read, write: if true;
    }
    match /weeklyTasks/{taskId} {
      allow read, write: if true;
    }
  }
}
